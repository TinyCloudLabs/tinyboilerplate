# Required. Generate a key from the repo root with:
# bun run packages/server/scripts/generate-key.ts examples/notes/backend/.env
BACKEND_PRIVATE_KEY=

# Optional backend settings. The defaults below match the Notes example.
TINYCLOUD_HOST=https://node.tinycloud.xyz
PORT=3002

# FRONTEND_URL controls the CORS origin. Leave unset to use the runtime default:
# http://localhost:5174, or https://localhost:5174 when trusted local cert files
# exist at ../frontend/localhost.pem and ../frontend/localhost-key.pem.
# FRONTEND_URL=http://localhost:5174

# HTTPS is auto-enabled when those trusted local cert files exist. Only override
# these paths when using certs your browser trusts, such as mkcert certs.
# HTTPS_CERT_FILE=../frontend/localhost.pem
# HTTPS_KEY_FILE=../frontend/localhost-key.pem
