# Optional frontend settings. The defaults below match the Notes backend.
VITE_OPENKEY_HOST=https://openkey.so

# Leave unset to derive the backend URL from the current page protocol:
# http://localhost:3002 without local certs, https://localhost:3002 when the
# frontend is served with trusted localhost.pem/localhost-key.pem cert files.
# VITE_BACKEND_URL=http://localhost:3002
