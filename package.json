{
  "name": "tinyboilerplate",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TinyCloudLabs/tinyboilerplate.git"
  },
  "workspaces": [
    "packages/*",
    "examples/react-express/frontend",
    "examples/react-express/backend"
  ],
  "_overridesNote": "Pin TinyCloud SDK versions to ensure consistent types across packages. Remove when all workspace packages align on compatible SDK ranges.",
  "overrides": {
    "@tinycloud/sdk-core": "1.5.0",
    "@tinycloud/sdk-services": "1.5.0",
    "@tinycloud/web-core": "1.1.0"
  },
  "scripts": {
    "build": "bun run build:core && bun run build:client && bun run build:server",
    "build:core": "cd packages/core && bun run build",
    "build:client": "cd packages/client && bun run build",
    "build:server": "cd packages/server && bun run build",
    "dev": "bun run build && concurrently --kill-others -n core,client,server,frontend,backend -c blue,cyan,magenta,green,yellow \"bun run dev:core\" \"bun run dev:client\" \"bun run dev:server\" \"bun run dev:frontend\" \"bun run dev:backend\"",
    "dev:core": "cd packages/core && bun run dev",
    "dev:client": "cd packages/client && bun run dev",
    "dev:server": "cd packages/server && bun run dev",
    "dev:frontend": "cd examples/react-express/frontend && bun run dev",
    "dev:backend": "cd examples/react-express/backend && bun run dev",
    "generate-key": "cd packages/server && bun run generate-key",
    "test": "bun run test:core && bun run test:client && bun run test:server",
    "test:core": "cd packages/core && bun test",
    "test:client": "cd packages/client && bun test",
    "test:server": "cd packages/server && bun test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tinycloud/node-sdk": "1.5.0",
    "concurrently": "^9.2.1",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "playwright": "^1.58.2",
    "prettier": "^3.8.1",
    "typescript-eslint": "^8.57.1"
  }
}
