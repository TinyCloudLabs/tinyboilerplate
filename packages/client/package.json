{
  "name": "@tinyboilerplate/client",
  "version": "0.1.0",
  "description": "Browser SDK for TinyCloud + OpenKey authentication, delegation, and API client",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/TinyCloudLabs/tinyboilerplate.git",
    "directory": "packages/client"
  },
  "keywords": [
    "tinycloud",
    "openkey",
    "web3",
    "delegation",
    "auth"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "bun test"
  },
  "dependencies": {
    "@tinyboilerplate/core": "workspace:*"
  },
  "peerDependencies": {
    "@openkey/sdk": ">=0.7.0",
    "@tinycloud/web-sdk": ">=1.5.0",
    "ethers": "^5.7.0 || ^6.0.0"
  },
  "peerDependenciesMeta": {
    "ethers": {
      "optional": true
    }
  },
  "devDependencies": {
    "@openkey/sdk": "^0.7.2",
    "@tinycloud/web-sdk": "~1.5.0",
    "ethers": "^5.7.2",
    "typescript": "^5.7.0"
  }
}
