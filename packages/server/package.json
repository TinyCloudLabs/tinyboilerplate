{
  "name": "@tinyboilerplate/server",
  "version": "0.1.0",
  "description": "Server SDK for JWT verification, delegation management, and auth middleware",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "scripts",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/TinyCloudLabs/tinyboilerplate.git",
    "directory": "packages/server"
  },
  "keywords": [
    "tinycloud",
    "openkey",
    "web3",
    "delegation",
    "auth"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch --preserveWatchOutput",
    "test": "bun test",
    "generate-key": "bun run scripts/generate-key.ts",
    "postinstall": "node scripts/fix-wasm-esm.mjs"
  },
  "dependencies": {
    "@tinyboilerplate/core": "workspace:*",
    "@tinycloud/node-sdk": "~1.5.0",
    "jose": "^5.0.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
