BACKEND_PRIVATE_KEY=
TINYCLOUD_HOST=https://node.tinycloud.xyz
PORT=3003
# FRONTEND_URL defaults to https://localhost:5175 when local certs exist.
# Use a trusted local cert for OpenKey/passkey flows. HTTPS with a certificate
# warning still blocks WebAuthn.
# FRONTEND_URL=http://localhost:5175

# Renewal. Set all three, or none. With none the sign-in is finite and /api/auth/verify-renewal answers 503.
# They let the backend reissue its 24 hour session token for a TinyCloud session that OpenKey's renewal lease keeps
# alive. RENEWAL_BACKEND_ORIGIN is this backend's public https origin. RENEWAL_NODE_DID and RENEWAL_RENEWER_DID are
# the did:key identities the node publishes at /.well-known/tinycloud/node-keys (nodeDid and renewerDid); for the
# production node they match OpenKey's OPENKEY_RENEWAL_NODE_DID and OPENKEY_RENEWAL_RENEWER_DID.
# RENEWAL_BACKEND_ORIGIN=
# RENEWAL_NODE_DID=
# RENEWAL_RENEWER_DID=
